# 统一使用 LF —— shell 脚本若被转成 CRLF，
# 在 Android/Linux 上执行会报 "bad interpreter: /bin/sh^M"
* text=auto eol=lf

*.sh    text eol=lf
*.example text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.qcow2 binary
*.xz    binary

# Magisk 安装器入口（无扩展名，需 LF 且可执行）
update-binary text eol=lf
