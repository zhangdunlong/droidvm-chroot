# ============================================================
# DroidVM Chroot 运行配置模板
#
# 实际位置：/data/adb/droidvm.env      权限必须是 600
# 首次刷入时 customize.sh 会自动生成一份到该路径；本文件仅供参考与对照。
#
#   su -c 'cp droidvm.env.example /data/adb/droidvm.env'
#   su -c 'chmod 600 /data/adb/droidvm.env'
#   su -c 'vi /data/adb/droidvm.env'        # 填下面标 <...> 的项
#   su -c 'sh /data/adb/modules/DroidVM-Chroot/bin/mgmt.sh restart'
#
# ⚠️ 这个文件含明文凭据，不要提交到任何仓库，也不要放进网盘同步。
# ============================================================

# ------------------------------------------------------------
# AI API 网关（端口 3065）
# ------------------------------------------------------------
# 管理端登录用户名
A2A_USER=admin

# 管理端密码。
#   · 留空 → 启动脚本会跳过 agent2api，不会用弱默认密码起服务
#   · 建议 16 位以上随机串，首次启动后到面板里再改一次
#   · 值里若含 # @ $ ! 等字符，**必须用单引号包起来**
A2A_PASS='<设置一个强密码>'

# ------------------------------------------------------------
# Caddy 自动 HTTPS（Let's Encrypt DNS-01）
# ------------------------------------------------------------
# Cloudflare API Token，权限**只需** Zone.DNS.Edit（不要用全局 Token）
# 获取：Cloudflare 控制台 → 我的个人资料 → API 令牌 → 创建令牌 → 编辑区域 DNS
# 留空 → Caddy 无法申请证书，HTTPS 入口起不来（HTTP 仍可用）
CF_API_TOKEN='<Cloudflare API Token>'

# Caddy 出站代理。
# 部分运营商/网络会阻断到 Let's Encrypt 与 Cloudflare 的**出站** 443，
# 表现为日志里 ACME 请求超时。此时填本机代理即可：
#   HTTPS_PROXY='http://127.0.0.1:7890'
# 注意：这只影响 Caddy 申请证书，与「入站 443 能否被访问」是两件事。
HTTPS_PROXY=''

# ------------------------------------------------------------
# 监控面板（端口 8765）
# ------------------------------------------------------------
# 顶部快捷入口。格式：名称|公网URL|内网URL，多条目用 ; 分隔
#   · 三段写法：内网访问用内网地址，公网访问用公网域名（推荐）
#   · 两段写法「名称|URL」表示内外网同一个地址
#   · {ip4} 会被替换成当前局域网 IP
#   · 留空 → 整张卡片隐藏
DASH_LINKS='青龙面板|https://ql.example.com|http://{ip4}:5700;AI 网关|https://ai.example.com|http://{ip4}:3065'

# 面板左上角显示的设备名，留空则显示 "Android Phone"
DASH_DEVICE_NAME='Android Phone'

# ------------------------------------------------------------
# Cloudflare Tunnel（可选，纯 IPv4 网络兜底）
# ------------------------------------------------------------
# 协议：
#   quic  — 默认，速度最好；要求出站 UDP 7844 可达
#   http2 — 回退，走 TCP 443；少数网络能过 quic 却过不了它
# 留空 = quic。
# 若日志报 "timeout: no recent network activity" 说明 UDP 被丢；
# 若报 "TLS handshake with edge error: EOF" 说明到边缘的 TLS 被阻断，
# 二者都属于外部网络条件，改用 IPv6 + Caddy 直连为主路径更可靠。
CF_PROTOCOL=

# ------------------------------------------------------------
# 排查备忘
# ------------------------------------------------------------
# 启动日志      /data/local/tmp/droidvm-boot.log
# 服务状态      su -c 'sh <module>/bin/mgmt.sh status'
# Caddy 日志    <rootfs>/var/log/caddy/caddy.out
# 隧道日志      <rootfs>/tmp/cf.log
# 面板日志      <rootfs>/opt/dashboard/dash.log
# IPv6 守护日志 /data/local/tmp/ipv6-guard.log
